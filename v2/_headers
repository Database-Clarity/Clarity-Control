# Cloudflare static-assets headers (copied into dist by Vite).
# Every page: no MIME sniffing; allow same-origin previews, never another site's frames.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'

# Hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry document must always be revalidated so a deploy is picked up at once.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
