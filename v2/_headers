# Cloudflare static-assets headers (copied into dist by Vite).
# Every page: no MIME sniffing, and never framed by another site.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry document must always be revalidated so a deploy is picked up at once.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
