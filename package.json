{
  "name": "clarity-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @clarity/web --",
    "build": "npm run build --workspaces --if-present && npm run build:publisher",
    "build:publisher": "node scripts/publisher/build.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts/publisher/tsconfig.json && tsc --noEmit -p scripts/mult-write/tsconfig.json && tsc --noEmit -p scripts/enhanced-arrow/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:reports-browser": "node apps/web/test/report-public-browser.mjs",
    "test:picker-browser": "node apps/web/test/picker-browser.mjs",
    "test:publisher-browser": "node apps/web/test/publisher-browser.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.12"
  }
}
