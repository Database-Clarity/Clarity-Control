@@ -17,9 +17,42 @@ on:
         description: Build the seven legacy files to `live` first (data publishes only).
         type: boolean
         required: true
+      publication:
+        description: Immutable publisher handoff (G5 callers only; empty preserves existing callers).
+        type: string
+        required: false
+        default: ''
 
 jobs:
+  handoff:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+    outputs:
+      converter: ${{ steps.identity.outputs.converter }}
+      record: ${{ steps.identity.outputs.record }}
+      generator: ${{ steps.identity.outputs.generator }}
+    steps:
+      - name: Validate handoff refs
+        id: identity
+        env:
+          PUBLICATION: ${{ inputs.publication }}
+          LEGACY: ${{ inputs.legacy }}
+        run: |
+          node --input-type=module <<'NODE'
+          import { appendFileSync } from 'node:fs';
+          if (process.env.PUBLICATION) {
+            if (process.env.LEGACY !== 'true') throw new Error('Publication requires legacy build');
+            const p = JSON.parse(process.env.PUBLICATION);
+            for (const key of ['commit', 'recordCommit', 'generatorSha']) {
+              if (typeof p[key] !== 'string' || !/^[a-f0-9]{40}$/.test(p[key])) throw new Error('Invalid publication ref');
+            }
+            appendFileSync(process.env.GITHUB_OUTPUT, `converter=${p.commit}\nrecord=${p.recordCommit}\ngenerator=${p.generatorSha}\n`);
+          }
+          NODE
+
   legacy:
+    needs: handoff
     if: inputs.legacy
     runs-on: ubuntu-latest
     timeout-minutes: 20
