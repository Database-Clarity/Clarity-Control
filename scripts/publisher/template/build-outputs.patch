+# Reusable build of every consumer output (spec section 3). Installed on the `converter` branch of
+# Database-Clarity/Live-Clarity-Database and called as
+#   Database-Clarity/Live-Clarity-Database/.github/workflows/build-outputs.yml@converter
+# by converter main.yml (people's pushes), the editor-data publish pipeline (downstream of its
+# converter push), and editor-data exports.yml (config saves, `legacy: false`).
+#
+# A reusable workflow runs in the caller's context, so every checkout names its repository and ref.
+# Callers cap the token: only main.yml and the pipeline grant `contents: write` (legacy job).
+# Configs are data: they are read from files by Node; no workflow expression or shell line ever
+# contains a config value.
+name: Build outputs
+
+on:
+  workflow_call:
+    inputs:
+      legacy:
+        description: Build the seven legacy files to `live` first (data publishes only).
+        type: boolean
+        required: true
+      publication:
+        description: Immutable publisher handoff (G5 callers only; empty preserves existing callers).
+        type: string
+        required: false
+        default: ''
+
+jobs:
+  handoff:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+    outputs:
+      converter: ${{ steps.identity.outputs.converter }}
+      record: ${{ steps.identity.outputs.record }}
+      generator: ${{ steps.identity.outputs.generator }}
+    steps:
+      - name: Validate handoff refs
+        id: identity
+        env:
+          PUBLICATION: ${{ inputs.publication }}
+          LEGACY: ${{ inputs.legacy }}
+          EVENT_INPUT: ${{ github.ref == 'refs/heads/converter' && github.sha || '' }}
+        run: |
+          node --input-type=module <<'NODE'
+          import { appendFileSync } from 'node:fs';
+          if (process.env.PUBLICATION) {
+            if (process.env.LEGACY !== 'true') throw new Error('Publication requires legacy build');
+            const p = JSON.parse(process.env.PUBLICATION);
+            for (const key of ['commit', 'recordCommit', 'generatorSha']) {
+              if (typeof p[key] !== 'string' || !/^[a-f0-9]{40}$/.test(p[key])) throw new Error('Invalid publication ref');
+            }
+            appendFileSync(process.env.GITHUB_OUTPUT, `converter=${p.commit}\nrecord=${p.recordCommit}\ngenerator=${p.generatorSha}\n`);
+          } else if (process.env.LEGACY === 'true') {
+            if (!/^[a-f0-9]{40}$/.test(process.env.EVENT_INPUT)) throw new Error('Legacy caller requires a pinned converter event');
+            appendFileSync(process.env.GITHUB_OUTPUT, 'converter=' + process.env.EVENT_INPUT + '\n');
+          }
+          NODE
+
+  legacy:
+    needs: handoff
+    if: inputs.legacy
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    # FIFO waiting queue (100 pending max), with exact inputs and the engine
+    # monotonic live-write guard. An older input is a green no-op, never an overwrite.
+    concurrency:
+      group: legacy-outputs
+      cancel-in-progress: false
+      queue: max
+    # No permissions block: the job keeps what the caller grants (contents: write from main.yml and
+    # the pipeline; exports.yml grants read and never runs this job).
+    steps:
+      - name: Check out converter (current head; engine in .exports)
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          repository: Database-Clarity/Live-Clarity-Database
+          ref: ${{ needs.handoff.outputs.converter || 'converter' }}
+          path: converter
+          fetch-depth: 0
+          filter: blob:none
+          persist-credentials: false
+      - name: Check out live (current head; the deploy pushes to it)
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          repository: Database-Clarity/Live-Clarity-Database
+          ref: live
+          path: live
+          fetch-depth: 0
+          filter: blob:none
+      - name: Check out export-pins (append-only; the pins are pushed to it)
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          repository: Database-Clarity/Live-Clarity-Database
+          ref: export-pins
+          path: pins
+      - name: Check out the legacy vocabulary baseline (editor-data exports/)
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          repository: Database-Clarity/Live-Clarity-Database
+          ref: ${{ needs.handoff.outputs.record || 'editor-data' }}
+          path: editor-data
+          sparse-checkout: |
+            exports
+            .publisher
+            publish/log
+          persist-credentials: false
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
+        with:
+          node-version: '24'
+      - name: Verify immutable legacy input
+        if: inputs.publication != ''
+        env:
+          PUBLICATION: ${{ inputs.publication }}
+          PROOF: editor-data
+        run: |
+          set -euo pipefail
+          node --input-type=module <<'NODE'
+          import { readFileSync } from 'node:fs';
+          import { execFileSync } from 'node:child_process';
+          import { createHash } from 'node:crypto';
+          const p = JSON.parse(process.env.PUBLICATION);
+          if (!/^[a-f0-9]{40}$/.test(p.commit) || !/^\.publish\/receipts\/\d{4}-\d{2}\/[0-7][0-9A-HJKMNP-TV-Z]{25}\.json$/.test(p.receiptPath)) throw new Error('Invalid receipt identity');
+          const r = JSON.parse(execFileSync('git', ['-C', 'converter', 'show', p.commit + ':' + p.receiptPath], { maxBuffer: 128 << 20 }));
+          const actual = createHash('sha256').update(readFileSync(process.env.PROOF + '/.publisher/verify-publication.mjs')).digest('hex');
+          if (!/^[a-f0-9]{64}$/.test(p.verifierSha256) || r.verifierSha256 !== p.verifierSha256 || actual !== r.verifierSha256) throw new Error('Receipt verifier digest mismatch');
+          NODE
+          node editor-data/.publisher/verify-publication.mjs converter editor-data
+      - name: Build the legacy files, deploy them to live, and write the publish pin
+        env:
+          RUN_ID: ${{ github.run_id }}
+          RUN_ATTEMPT: ${{ github.run_attempt }}
+        run: >-
+          node converter/.exports/legacy-job.mjs run
+          --converter converter --live live --pins pins
+          --vocab editor-data/exports/legacy-vocab.json
+          --run-id "$RUN_ID" --attempt "$RUN_ATTEMPT"
+
+  site:
+    needs: [handoff, legacy]
+    # After the legacy job, or when it was skipped (config saves) or failed: the site then builds
+    # from the latest pin, consistent and one publish behind.
+    if: ${{ !cancelled() && needs.handoff.result == 'success' && (inputs.publication == '' || needs.legacy.result == 'success') }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    # The deploy token is a secret of this environment only; its deployment branches are
+    # `converter` and `editor-data` (the callers' refs). A reusable workflow gets environment
+    # secrets only through a job that names the environment.
+    environment: data-site-deploy
+    # Repo-wide and separate from legacy-outputs, so a config save never replaces a legacy build.
+    # One run active, at most one pending (a newer pending run replaces an older one; every run
+    # reads both branch heads at its start).
+    concurrency:
+      group: data-site
+      cancel-in-progress: false
+      queue: max
+    permissions:
+      contents: read
+    steps:
+      - name: Check out converter (engine in .exports; the pinned input by SHA)
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          repository: Database-Clarity/Live-Clarity-Database
+          ref: ${{ needs.handoff.outputs.converter || 'converter' }}
+          path: converter
+          fetch-depth: 0
+          filter: blob:none
+          persist-credentials: false
+      - name: Check out live (legacy copies at the pin's live commit)
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          repository: Database-Clarity/Live-Clarity-Database
+          ref: live
+          path: live
+          fetch-depth: 0
+          filter: blob:none
+          persist-credentials: false
+      - name: Check out export-pins (read only)
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          repository: Database-Clarity/Live-Clarity-Database
+          ref: export-pins
+          path: pins
+          persist-credentials: false
+      - name: Check out the project configs (editor-data exports/)
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          repository: Database-Clarity/Live-Clarity-Database
+          ref: editor-data
+          path: editor-data
+          sparse-checkout: exports
+          persist-credentials: false
+      # Config-only deployments share this job's data-site slot. Read current
+      # configs after taking it; keep the immutable publication proof separate.
+      - name: Check out the publication proof (immutable RECORD)
+        if: inputs.publication != ''
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          repository: Database-Clarity/Live-Clarity-Database
+          ref: ${{ needs.handoff.outputs.record }}
+          path: producer
+          sparse-checkout: |
+            .publisher
+            publish/log
+          persist-credentials: false
+      - name: Check out the generator catalog (the pin's generatorSha by SHA)
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          repository: Database-Clarity/Description-data-generator
+          ref: ${{ needs.handoff.outputs.generator || 'v2' }}
+          path: generator
+          fetch-depth: 0
+          filter: blob:none
+          persist-credentials: false
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
+        with:
+          node-version: '24'
+      - name: Verify immutable site input
+        id: verify
+        if: inputs.publication != ''
+        env:
+          PUBLICATION: ${{ inputs.publication }}
+          PROOF: producer
+        run: |
+          set -euo pipefail
+          node --input-type=module <<'NODE'
+          import { readFileSync } from 'node:fs';
+          import { execFileSync } from 'node:child_process';
+          import { createHash } from 'node:crypto';
+          const p = JSON.parse(process.env.PUBLICATION);
+          if (!/^[a-f0-9]{40}$/.test(p.commit) || !/^\.publish\/receipts\/\d{4}-\d{2}\/[0-7][0-9A-HJKMNP-TV-Z]{25}\.json$/.test(p.receiptPath)) throw new Error('Invalid receipt identity');
+          const r = JSON.parse(execFileSync('git', ['-C', 'converter', 'show', p.commit + ':' + p.receiptPath], { maxBuffer: 128 << 20 }));
+          const actual = createHash('sha256').update(readFileSync(process.env.PROOF + '/.publisher/verify-publication.mjs')).digest('hex');
+          if (!/^[a-f0-9]{64}$/.test(p.verifierSha256) || r.verifierSha256 !== p.verifierSha256 || actual !== r.verifierSha256) throw new Error('Receipt verifier digest mismatch');
+          NODE
+          node producer/.publisher/verify-publication.mjs converter producer pins live
+      - name: Find the served deployment (Pages API; zero deployments = bootstrap)
+        if: inputs.publication == '' || steps.verify.outputs.build == 'true'
+        env:
+          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
+          CLOUDFLARE_ACCOUNT_ID: ${{ vars.CLOUDFLARE_ACCOUNT_ID }}
+          PAGES_PROJECT: ${{ vars.PAGES_PROJECT }}
+        run: node converter/.exports/build-site.mjs locate --pages-project "$PAGES_PROJECT" --out "$RUNNER_TEMP/site-state.json"
+      - name: Build the site (no secrets in this step)
+        if: inputs.publication == '' || steps.verify.outputs.build == 'true'
+        id: build
+        run: >-
+          node converter/.exports/build-site.mjs build
+          --state "$RUNNER_TEMP/site-state.json"
+          --converter converter --live live --pins pins
+          --exports editor-data/exports --generator generator
+          --out "$RUNNER_TEMP/site" --result "$RUNNER_TEMP/site-result.json"
+      - name: Deploy (one atomic Pages deployment)
+        if: steps.build.outputs.deploy == 'true'
+        env:
+          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
+          CLOUDFLARE_ACCOUNT_ID: ${{ vars.CLOUDFLARE_ACCOUNT_ID }}
+          PAGES_PROJECT: ${{ vars.PAGES_PROJECT }}
+        run: >-
+          npx -y wrangler@4.153.0 pages deploy "$RUNNER_TEMP/site"
+          --project-name "$PAGES_PROJECT" --branch main
+          --commit-hash "$GITHUB_SHA" --commit-message "data site build" --commit-dirty=true
