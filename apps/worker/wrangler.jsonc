{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clarity-editor-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "account_id": "c5ec2772673dc72f5e58587ef4c80ff8",
  // D1 databases created by root 2026-11-11 (clarity-reports, clarity-reports-files).
  "d1_databases": [
    {
      "binding": "REPORTS_DB",
      "database_name": "clarity-reports",
      "database_id": "cc64d535-2c2b-47d1-b531-500334536610",
      "migrations_dir": "migrations/reports",
    },
    {
      "binding": "REPORTS_FILES_DB",
      "database_name": "clarity-reports-files",
      "database_id": "2c528593-c394-436b-a005-3dead7dff004",
      "migrations_dir": "migrations/files",
    },
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_SECRET",
      "GITHUB_PRIVATE_KEY",
      "SESSION_SECRET",
      "TURNSTILE_SECRET",
    ],
  },
  "vars": {
    "SITE_ORIGIN": "https://database-clarity.github.io",
    "SITE_ORIGINS": "https://database-clarity.github.io,https://control.d2clarity.com",
    "SITE_URL": "https://database-clarity.github.io/Clarity-Control/v2/",
    "GITHUB_OWNER": "Database-Clarity",
    "GITHUB_REPO": "Live-Clarity-Database",
    "DATA_BRANCH": "editor-data",
    "LIVE_BRANCH": "converter-v2-test",
    "GENERATOR_OWNER": "Database-Clarity",
    "GENERATOR_REPO": "Description-data-generator",
    "GENERATOR_BRANCH": "v2",
    "GITHUB_APP_ID": "5561594",
    "GITHUB_APP_SLUG": "clarity-editor-backend",
    "GITHUB_INSTALLATION_ID": "177372397",
    "GITHUB_CLIENT_ID": "Iv23lieVGtlnUyreJ7o4",
    "OAUTH_CALLBACK_URL": "https://clarity-editor-api.cboweris.workers.dev/auth/callback",
  },
}
